# =====================
# HIGHFIVE RELEASE vx.y
# =====================

# Versions des images
FRONTEND_VERSION=2.0.1
CORE_VERSION=2.0.0
CANVAS_VERSION=2.0.0
AI_VERSION=2.1.1

# DB
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Secret du service IA
JWT_SECRET=clee-super-secret
OPENAI_API_KEY=your-openai-api-key

# Stockage objet
MINIO_REGION=eu-west-3
CORE_BUCKET=highfive-core-bucket
CANVAS_BUCKET=hocuspocus-bucket-dev

# Sessions du core (jetons opaques hachees : sel secret et stable, le changer
# deconnecte tout le monde)
SESSION_TOKEN_PEPPER=change-me-pepper
SESSION_TTL_DAYS=30

# Secrets partages entre le core et le service canvas : les deux services
# doivent voir exactement les memes valeurs.
CANVAS_JWT_SECRET=change-me-canvas
CANVAS_INTERNAL_SECRET=dev-internal-secret

# Divers core
CORS_ORIGINS=*
ADMIN_EMAILS=
AI_TENANT_ID=00000000-0000-4000-8000-000000000001
AI_TIMEOUT_MS=12000
OPENAI_MODEL=gpt-4o-mini

# Ports exposes sur l'hote (a changer en cas de conflit avec un autre projet)
GATEWAY_PORT=52
DB_HOST_PORT=5432
MINIO_HOST_PORT=9000
MINIO_CONSOLE_PORT=9001
