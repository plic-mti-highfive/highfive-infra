# Versions des images
FRONTEND_VERSION=latest
CORE_VERSION=latest
CANVAS_VERSION=latest
AI_VERSION=latest

# DB
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Secrets
JWT_SECRET=clee-super-secret
